NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
MVP_ACCESS_CODE=replace-with-a-test-access-code
COOKIE_SIGNING_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=product_finder_session
AUTH_TTL_SECONDS=3600

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-primary-openrouter-generation-key
OPENROUTER_BACKUP_API_KEY=replace-with-backup-openrouter-generation-key
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=AI Product Finder
VERCEL_GENERATION_FALLBACK_ENABLED=true
VERCEL_AI_GATEWAY_API_KEY=replace-with-vercel-ai-gateway-key
VERCEL_AI_GATEWAY_MODEL=minimax/minimax-m3-free
VERCEL_AI_GATEWAY_FALLBACK_MODELS=minimax/minimax-m2.7-free
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
VERCEL_RESEARCH_MODEL=zai/glm-5.3-flash
KNOWLEDGE_FALLBACK_ENABLED=true
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=15000

# Enable only after ingesting a release with the same embedding model.
EMBEDDING_ENABLED=false
EMBEDDING_API_KEY=replace-with-primary-openrouter-embedding-key
EMBEDDING_BACKUP_API_KEY=replace-with-backup-openrouter-embedding-key
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_MS=30000

EASTMAN_PRODUCT_FINDER_URL=https://www.eastman.com/en/products/product-finder
CORPUS_ARTIFACT_DIR=../artifacts
CORPUS_WARN_AGE_HOURS=48
INGEST_CONCURRENCY=4
INGEST_TIMEOUT_MS=30000

CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_HISTORY_TURNS=10
CHAT_MAX_HISTORY_CHARS=20000
DOCUMENT_FETCH_TIMEOUT_MS=15000
DOCUMENT_CACHE_TTL_SECONDS=3600
WS_MAX_PAYLOAD_BYTES=32768
WS_HEARTBEAT_MS=30000
LOG_LEVEL=info
